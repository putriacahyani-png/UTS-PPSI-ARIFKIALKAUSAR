# ============================================================
#  SMARTROAD — .gitignore
#  Sistem Monitoring Infrastruktur Jalan Berbasis Web
# ============================================================

# --- Environment Variables & Secrets ---
.env
.env.*
*.env
.env.local
.env.development.local
.env.production.local

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Build Output ---
dist/
build/
out/
.next/
.nuxt/
.cache/

# --- Vite ---
.vite/

# --- TypeScript ---
*.tsbuildinfo

# --- Rust / Cargo (Backend) ---
backend/target/
backend/Cargo.lock
**/*.rs.bk
*.pdb

# --- Editor & IDE ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V500
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs ---
logs/
*.log

# --- Backup Files (Local Tahap 7-9) ---
backup/

# --- Credentials & Token Files ---
*.pem
*.key
*.cert
*.p12
credentials.json
secrets.json
token.json

# --- Misc ---
*.bak
*.tmp
*.temp
.yarn/
